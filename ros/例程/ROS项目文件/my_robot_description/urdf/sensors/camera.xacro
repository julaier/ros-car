<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 定义相机宏 -->
  <xacro:macro name="camera_macro" params="prefix parent x z">
    <!-- 定义相机的链接 -->
    <link name="${prefix}_link">
      <visual>
        <!-- 这里假设相机是一个长方体，可以调整尺寸和形状 -->
        <geometry><box size="0.05 0.05 0.1"/></geometry>
        <!-- 长方体的尺寸：宽度和高度为0.05米，深度为0.1米 -->
        <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
        <!-- 设置颜色为灰色 -->
      </visual>
      <!-- 如果需要相机的其他视觉特征，如镜头，可以添加额外的几何形状 -->
    </link>

    <!-- 定义相机的关节 -->
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
      <!-- 设置关节的原点位置，x 和 z 坐标由传入的参数来决定，y 坐标为 0 -->
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
      <!-- 相机相对于父链接的位置偏移：x 轴和 z 轴的值由参数传入 -->
    </joint>
    
    <link name ="${prefix}_link_optical"/>

    <joint name ="${prefix}_optical_joint" type="fixed">
    <parent link="${prefix}_link"/>
    <child link="${prefix}_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5 0 -1.5"/>
<joint/>
    <!-- 如果需要定义相机传感器的标定，可以在这里添加更多细节 -->
    <!-- 例如传感器的光学参数、相机的分辨率、镜头焦距等，可以通过参数传递或硬编码 -->
  </xacro:macro>
</robot>
