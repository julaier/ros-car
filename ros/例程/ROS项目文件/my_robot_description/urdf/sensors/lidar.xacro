<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 定义雷达的宏 -->
  <xacro:macro name="lidar_macro" params="prefix parent x y:=0 z">
    
    <!-- 创建雷达的link，包含可视化、碰撞体积和惯性属性 -->
    <link name="${prefix}_link">
      <visual>
        <!-- 可视化的原点设置为(0, 0, 0)，没有旋转 -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- 使用一个圆柱体表示雷达的形状，半径为0.035，长度为0.04 -->
          <cylinder radius="0.035" length="0.04"/>
        </geometry>
        <material name="black">
          <!-- 设置材质颜色为黑色 -->
          <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <!-- 碰撞体积与可视化部分相同 -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <!-- 设置雷达的质量和惯性矩 -->
        <mass value="0.17"/> 
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- 创建与机器人底盘的固定连接 -->
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
      <!-- 设置连接的位置，默认使用x、y、z作为位置坐标 -->
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>

    <!-- 删除Gazebo传感器和插件的配置 -->
    <!-- <gazebo reference="${prefix}_link">
      <sensor type="ray" name="${prefix}_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize> 
        <update_rate>10</update_rate> 
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle> 
              <max_angle>3.1415926</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min> 
            <max>12.0</max> 
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
          <topicName>/scan</topicName>
          <frameName>${prefix}_link</frameName>
        </plugin>
      </sensor>
    </gazebo> -->
  </xacro:macro>

</robot>
